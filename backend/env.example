# Backend Environment Variables

# HeyGen Video Avatar Configuration
# Get your API key from: https://app.heygen.com/settings?nav=API
# Available for Enterprise customers, trial tokens for Creator and Teams plans
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_API_BASE=https://api.heygen.com

# ElevenLabs TTS Configuration (for custom agent voices)
# Get your API key from: https://elevenlabs.io/
# Required for high-quality custom voice synthesis in video avatars
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Other API configurations would go here...
# (Add other environment variables as needed)